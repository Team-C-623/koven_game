code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;





// 3D Noise with friendly permission by Inigo Quilez
vec3 hash_noise_range( vec3 p ) {
	p *= mat3(vec3(127.1, 311.7, -53.7), vec3(269.5, 183.3, 77.1), vec3(-301.7, 27.3, 215.3));
	return 2.0 * fract(fract(p)*4375.55) -1.;
}


void vertex() {
// Input:4
	vec3 n_out4p0 = VERTEX;
	float n_out4p3 = n_out4p0.b;


// Input:8
	float n_out8p0 = TIME;


// FloatFunc:7
	float n_out7p0 = sin(n_out8p0);


// VectorCompose:6
	float n_in6p1 = 1.00000;
	float n_in6p2 = 1.00000;
	vec3 n_out6p0 = vec3(n_out7p0, n_in6p1, n_in6p2);


	vec3 n_out9p0;
// If:9
	float n_in9p1 = 0.00000;
	float n_in9p2 = 0.00001;
	vec3 n_in9p3 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in9p4 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out4p3 - n_in9p1) < n_in9p2)
	{
		n_out9p0 = n_in9p3;
	}
	else if(n_out4p3 < n_in9p1)
	{
		n_out9p0 = n_out6p0;
	}
	else
	{
		n_out9p0 = n_in9p4;
	}


// VectorOp:2
	vec3 n_out2p0 = n_out4p0 + n_out9p0;


// RandomRange:10
	vec3 n_in10p0 = vec3(1.00000, 1.00000, 1.00000);
	float n_in10p1 = 0.00000;
	float n_in10p2 = 1.00000;
	float n_out10p0 = mix(n_in10p1, n_in10p2, hash_noise_range(n_in10p0).x);


// Output:0
	VERTEX = n_out2p0;
	COLOR.rgb = vec3(n_out10p0);


}
